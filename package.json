{
  "name": "dsh-plugin-tic80",
  "version": "1.0.0",
  "description": "DeepSeek Harness (dsh) plugin for TIC-80 fantasy console: full console capabilities, conversational code, music, map, and sprite generation by LLM, with native & live web execution.",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "test": "node scripts/test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "vendor/tic80-web",
    "vendor/bin",
    "assets",
    "cartridge",
    "cordis.patch.yml",
    "screenshots.json",
    "tic80.exe",
    "SDL2.dll",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "cordis-plugin",
    "deepseek-harness",
    "tic-80",
    "fantasy-console",
    "gamedev",
    "pixel-art",
    "chiptune"
  ],
  "author": "NoodleStormno",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NoodleStormno/dsh-plugin-tic80.git"
  },
  "bugs": {
    "url": "https://github.com/NoodleStormno/dsh-plugin-tic80/issues"
  },
  "homepage": "https://github.com/NoodleStormno/dsh-plugin-tic80#readme",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./core": {
      "types": "./lib/core/index.d.ts",
      "import": "./lib/core/index.js"
    },
    "./runner": {
      "types": "./lib/runner/index.d.ts",
      "import": "./lib/runner/index.js"
    },
    "./templates": {
      "types": "./lib/templates/index.d.ts",
      "import": "./lib/templates/index.js"
    },
    "./tools": {
      "types": "./lib/tools/index.d.ts",
      "import": "./lib/tools/index.js"
    },
    "./prompts": {
      "types": "./lib/prompts/index.d.ts",
      "import": "./lib/prompts/index.js"
    }
  },
  "dependencies": {
    "fengari-web": "^0.1.4",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5.0.0-0",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.2.0-0",
    "@deepseek-ai/schemastery": ">=3.0.0 <4.0.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": false
    },
    "@deepseek-ai/dsh-tools": {
      "optional": false
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.10",
    "typescript": "^5.7.2"
  }
}
